# ─────────────────────────────────────────────────────────────────────────────
# Streamlit secrets template — copy to `.streamlit/secrets.toml` (LOCAL testing)
# or paste the key=value pairs into your platform's secret manager:
#   • Streamlit Community Cloud → Settings ▸ Secrets (dashboard)
#   • Hugging Face Spaces        → Settings ▸ Variables and secrets
#   • Render / Railway / Docker  → environment variables (no code change needed)
#
# NEVER commit the real `.streamlit/secrets.toml` — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Required for live answers (both RAG systems share the QA model)
GROQ_API_KEY = "your_groq_api_key"

# GraphRAG tab only — Neo4j AuraDB connection (cloud instance)
NEO4J_URI = "neo4j+s://<db_id>.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "your_neo4j_password"

# Optional — only if you switch providers in config/settings.py
# OPENROUTER_API_KEY = ""
# OPENAI_API_KEY = ""
# HUGGINGFACE_API_KEY = ""
# GOOGLE_API_KEY = ""
